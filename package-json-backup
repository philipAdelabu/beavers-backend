{
  "name": "beaverworks-backend",
  "version": "1.0.0",
  "description": "BeaverWorks - Artisan Service Platform Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs beaverworks-api",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "seed": "node scripts/seed.js",
    "seed:all": "node scripts/seed.js --all",
    "seed:test": "node scripts/seed.js --test",
    "db:reset": "npm run migrate:down && npm run migrate:up && npm run seed",
    "db:backup": "node scripts/backup.js",
    "create-admin": "node scripts/create-admin.js",
    "health-check": "node scripts/health-check.js",
    "generate-report": "node scripts/generate-report.js",
    "clean:logs": "node scripts/clean-logs.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f",
    "postinstall": "npm run db:reset || true"  
  },
  "keywords": [
    "beaverworks",
    "artisan",
    "service-platform",
    "on-demand",
    "marketplace",
    "api",
    "nodejs",
    "express",
    "postgresql",
    "redis",
    "socketio"
  ],
  "author": "BeaverWorks Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beaverworks/backend.git"
  },
  "bugs": {
    "url": "https://github.com/beaverworks/backend/issues"
  },
  "homepage": "https://github.com/beaverworks/backend#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.6.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "aws-sdk": "^2.1503.0",
    "stripe": "^14.11.0",
    "twilio": "^4.19.3",
    "nodemailer": "^6.9.7",
    "node-cron": "^3.0.3",
    "bull": "^4.11.5",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "geolib": "^3.3.4",
    "node-geocoder": "^4.2.1",
    "axios": "^1.6.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "handlebars": "^4.7.8",
    "pdfkit": "^0.14.0",
    "exceljs": "^4.4.0",
    "csv-writer": "^1.6.0",
    "sharp": "^0.33.0",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^4.0.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "csurf": "^1.11.0",
    "xss": "^1.0.14",
    "sanitize-html": "^2.11.0",
    "crypto-js": "^4.2.0",
    "google-libphonenumber": "^3.2.34",
    "validator": "^13.11.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.10",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.1.0",
    "faker": "^5.5.3",
    "@faker-js/faker": "^8.3.1",
    "sinon": "^17.0.1",
    "mockdate": "^3.0.5",
    "nock": "^13.4.0",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "airbnb-base",
      "plugin:security/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "import/no-extraneous-dependencies": ["error", { "devDependencies": true }],
      "consistent-return": "off",
      "camelcase": "off",
      "no-underscore-dangle": "off",
      "max-len": ["error", { "code": 120 }]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  }
}