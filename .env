# Server Configuration
NODE_ENV=development # Change to 'production' in production environment
PORT=3000
HOST=localhost  // Change to server IP or domain in production
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beaverworks
DB_USER=postgres
DB_PASSWORD=admin
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=63066a5b957a747fbf5cebd071dbecbb65e3845b81342b03ea79e2481db14b7e
JWT_REFRESH_SECRET=a958521dc06dda83a24d649f28339e095d51fd4b2d5d8959e60b5e89aa4f9b51
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=beaverworks-uploads
AWS_CLOUDFRONT_URL=https://your-cloudfront.cloudfront.net

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLATFORM_FEE_PERCENT=10

# Paystack Payment Configuration (Nigeria)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Flutterwave Payment Configuration
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE_your_flutterwave_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_your_flutterwave_public_key
FLUTTERWAVE_SECRET_HASH=your_flutterwave_hash
FLUTTERWAVE_ENCRYPTION_KEY=your_encryption_key

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGyour_messaging_service_sid

# Email Configuration (SendGrid / SMTP)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=no-reply@beaverworks.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@beaverworks.com
EMAIL_PASS=your_email_password

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=beaverworks-12345
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKey\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@beaverworks-12345.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKey
GOOGLE_PLACES_API_KEY=AIzaSyYourPlacesApiKey

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
JOB_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_MAX=20

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
MAX_FILES_PER_UPLOAD=10

# Cache Configuration
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER_SESSION=86400
CACHE_TTL_LOCATION=60
CACHE_TTL_ANALYTICS=300

# Logging Configuration
LOG_LEVEL=info
LOG_MAX_FILES=5
LOG_MAX_SIZE=10485760
LOG_DIR=./logs

# Application Configuration
APP_NAME=BeaverWorks
APP_URL=https://api.beaverworks.com
APP_FRONTEND_URL=https://beaverworks.com
APP_ADMIN_URL=https://admin.beaverworks.com

# Feature Flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_GEOLOCATION=true
ENABLE_ESCROW=true
ENABLE_DISPUTES=true

# Pricing Configuration
BASE_FEE=2500
DIAGNOSTICS_RATE_PER_MINUTE=500
PLATFORM_COMMISSION_PERCENT=10
MONTHLY_TECHNOLOGY_FEE=5000
ARTISAN_ONBOARDING_FEE=5000
ESCROW_DISPUTE_BUFFER_DAYS=3

# Geofencing Configuration
GEOFENCE_RADIUS_METERS=100
GEOFENCE_CHECK_INTERVAL_SECONDS=30
MAX_TRAVEL_DISTANCE_KILOMETERS=50

# Job Configuration
JOB_OFFER_EXPIRY_MINUTES=2
JOB_ARRIVAL_TIMEOUT_MINUTES=30
JOB_DIAGNOSTICS_TIMEOUT_MINUTES=60
JOB_EXECUTION_TIMEOUT_HOURS=8

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret
CSRF_SECRET=your_csrf_secret
CORS_ORIGINS=http://localhost:3000,https://beaverworks.com

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your_new_relic_key
NEW_RELIC_APP_NAME=BeaverWorks-API

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Webhook URLs
WEBHOOK_BASE_URL=https://api.beaverworks.com/api/v1/webhooks
WEBHOOK_TEST_SECRET=test_webhook_secret_12345

# Development Only (not for production)
DEBUG_MODE=false
SEED_TEST_DATA=false
SKIP_VERIFICATION=false


# File Upload Configuration
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/heic
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime

# Image Optimization
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1200
IMAGE_MAX_HEIGHT=1200

# Storage (for production, use cloud storage like S3)
STORAGE_TYPE=local
AWS_BUCKET_NAME=beaverworks-uploads
AWS_REGION=us-east-1
CLOUDFRONT_URL=https://your-cloudfront.cloudfront.net